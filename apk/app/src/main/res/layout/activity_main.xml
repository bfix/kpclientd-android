<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:padding="16dp">

    <!-- 1. Das Logo ganz oben zentrieren -->
    <ImageView
        android:id="@+id/imageLogo"
        android:layout_width="224dp"
        android:layout_height="253dp"
        android:layout_marginTop="24dp"
        app:srcCompat="@drawable/katzenpost"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

    <!-- 2. Der Titel "kpclientd" unter dem Logo -->
    <TextView
        android:id="@+id/textTitle"
        android:layout_width="270dp"
        android:layout_height="wrap_content"
        android:layout_marginTop="16dp"
        android:fontFamily="sans-serif-black"
        android:text="kpclientd"
        android:textAlignment="center"
        android:textColor="#693DE6"
        android:textSize="48sp"
        app:layout_constraintTop_toBottomOf="@id/imageLogo"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

    <!-- 3. Der Status-Text unter dem Titel -->
    <TextView
        android:id="@+id/textStatus"
        android:layout_width="270dp"
        android:layout_height="wrap_content"
        android:layout_marginTop="16dp"
        android:fontFamily="sans-serif-black"
        android:text="Daemon gestoppt"
        android:textAlignment="center"
        android:textSize="24sp"
        app:layout_constraintTop_toBottomOf="@id/textTitle"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

    <!-- 4. Start-Button unten links platziert -->
    <Button
        android:id="@+id/btn_start"
        style="@style/Widget.Material3.Button.Icon"
        android:layout_width="123dp"
        android:layout_height="120dp"
        android:layout_marginTop="32dp"
        android:layout_marginEnd="8dp"
        app:cornerRadius="30dp"
        app:icon="@android:drawable/ic_media_play"
        app:iconSize="100dp"
        app:layout_constraintTop_toBottomOf="@id/textStatus"
        app:layout_constraintEnd_toStartOf="@+id/btn_stop"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintHorizontal_chainStyle="packed" />

    <!-- 5. Stopp-Button unten rechts (neben dem Start-Button eingekettet) -->
    <Button
        android:id="@+id/btn_stop"
        style="@style/Widget.Material3.Button.Icon"
        android:layout_width="123dp"
        android:layout_height="120dp"
        android:layout_marginTop="32dp"
        android:layout_marginStart="8dp"
        app:cornerRadius="30dp"
        app:icon="@android:drawable/ic_media_pause"
        app:iconSize="100dp"
        app:layout_constraintTop_toBottomOf="@id/textStatus"
        app:layout_constraintStart_toEndOf="@+id/btn_start"
        app:layout_constraintEnd_toEndOf="parent" />

</androidx.constraintlayout.widget.ConstraintLayout>
